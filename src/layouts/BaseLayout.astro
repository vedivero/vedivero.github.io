---
import { siteConfig } from "@/config/site";
import "@/styles/global.css";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: "website" | "article";
  noindex?: boolean;
  prevUrl?: string;
  nextUrl?: string;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title = siteConfig.title,
  description = siteConfig.description,
  image = siteConfig.socialImage,
  type = "website",
  noindex = false,
  prevUrl,
  nextUrl,
  structuredData,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, siteConfig.siteUrl).toString();
const absoluteImage = new URL(image, siteConfig.siteUrl).toString();
const pageTitle = title === siteConfig.title ? title : `${title} | ${siteConfig.name}`;
const defaultStructuredData = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: siteConfig.name,
  url: siteConfig.siteUrl,
  description: siteConfig.description,
  publisher: {
    "@type": "Organization",
    name: siteConfig.authorName,
  },
};
const schema = structuredData ?? defaultStructuredData;
---

<!doctype html>
<html lang={siteConfig.language} data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link
      rel="preload"
      href="/fonts/geist/Geist-Variable.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    {prevUrl && <link rel="prev" href={new URL(prevUrl, siteConfig.siteUrl).toString()} />}
    {nextUrl && <link rel="next" href={new URL(nextUrl, siteConfig.siteUrl).toString()} />}
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${siteConfig.name} RSS`}
      href={new URL("/rss.xml", siteConfig.siteUrl).toString()}
    />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:locale" content={siteConfig.locale} />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={absoluteImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteImage} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
    <script is:inline>
      /*
       * Runs before first paint so the stored reading mode is applied without a
       * flash. Falls back to the system preference until the reader picks a side.
       */
      (() => {
        const storageKey = "monograph-theme";
        const root = document.documentElement;
        const systemDark = window.matchMedia("(prefers-color-scheme: dark)");
        let storedTheme;

        try {
          storedTheme = localStorage.getItem(storageKey);
        } catch {
          storedTheme = null;
        }

        const updateToggles = (theme) => {
          const isDark = theme === "dark";
          document.querySelectorAll("[data-theme-toggle]").forEach((button) => {
            button.setAttribute("aria-checked", String(isDark));
            button.setAttribute(
              "aria-label",
              isDark ? "Switch to light mode" : "Switch to dark mode",
            );
          });
        };

        const setTheme = (theme, persist = false) => {
          root.dataset.theme = theme;
          if (persist) {
            storedTheme = theme;
            try {
              localStorage.setItem(storageKey, theme);
            } catch {}
          }
          updateToggles(theme);
        };

        const preferredTheme =
          storedTheme === "light" || storedTheme === "dark"
            ? storedTheme
            : systemDark.matches
              ? "dark"
              : "light";

        setTheme(preferredTheme);

        systemDark.addEventListener("change", (event) => {
          if (storedTheme === "light" || storedTheme === "dark") return;
          setTheme(event.matches ? "dark" : "light");
        });

        window.addEventListener("DOMContentLoaded", () => {
          updateToggles(root.dataset.theme || preferredTheme);
          document.querySelectorAll("[data-theme-toggle]").forEach((button) => {
            button.addEventListener("click", () => {
              setTheme(root.dataset.theme === "dark" ? "light" : "dark", true);
            });
          });
        });
      })();
    </script>
    <script is:inline>
      /*
       * Casual-copy deterrent: blocks selection, drag, the context menu, and the
       * devtools shortcuts.
       *
       * This is friction, not security. The page is static, so its HTML, CSS and
       * JS all reach the visitor regardless, and devtools still opens from the
       * browser's own menu — no page script can reach that. Form fields and the
       * code-copy buttons stay exempt so the /admin editor and the "Copy" action
       * keep working.
       */
      (() => {
        const EDITABLE = "input, textarea, select, [contenteditable=''], [contenteditable='true']";

        /* event.target is often a text node, which has no closest(); resolve it
           to its parent element first. Also treat whatever currently has focus
           as editable, because a selection inside a field does not always
           report that field as the target. */
        const isEditable = (node) => {
          const el =
            node instanceof Element ? node : node instanceof Node ? node.parentElement : null;

          if (el?.closest(`${EDITABLE}, .code-copy-frame, pre, code`)) return true;
          return Boolean(document.activeElement?.closest(EDITABLE));
        };

        for (const type of ["contextmenu", "selectstart", "dragstart"]) {
          document.addEventListener(
            type,
            (event) => {
              if (isEditable(event.target)) return;
              event.preventDefault();
            },
            { capture: true },
          );
        }

        document.addEventListener(
          "keydown",
          (event) => {
            const key = event.key.toLowerCase();

            // Let every shortcut through while typing, or the editor breaks.
            if (isEditable(event.target)) return;

            const blocked =
              event.key === "F12" ||
              ((event.ctrlKey || event.metaKey) &&
                event.shiftKey &&
                (key === "i" || key === "j" || key === "c")) ||
              ((event.ctrlKey || event.metaKey) &&
                event.altKey &&
                (key === "i" || key === "j" || key === "c")) ||
              ((event.ctrlKey || event.metaKey) && (key === "u" || key === "s"));

            if (blocked) event.preventDefault();
          },
          { capture: true },
        );
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>
    <slot />
  </body>
</html>
