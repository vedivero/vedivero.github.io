---
/**
 * The résumé's own controls, pinned to the right edge: a section navigator, a
 * print button, and the theme toggle.
 *
 * This page drops SiteHeader, which is where the theme switch normally lives —
 * `data-theme-toggle` is all the layout's inline script needs, so the button
 * hooks into the existing behaviour rather than duplicating it.
 */

interface Props {
  /** Section ids and labels, in page order. */
  sections: { id: string; label: string }[];
}

const { sections } = Astro.props;
---

<nav class="resume-nav" aria-label="Sections">
  <ul>
    {
      sections.map((section) => (
        <li>
          <a href={`#${section.id}`} data-resume-nav={section.id}>
            {section.label}
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<div class="resume-tools" aria-label="Résumé tools">
    <button type="button" class="resume-tool" data-resume-print aria-label="Print this résumé">
      <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path
          d="M7 9V3h10v6M7 19H5a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
        <path
          d="M7 15h10v6H7z"
          stroke="currentColor"
          stroke-width="2"
          stroke-linejoin="round"></path>
      </svg>
    </button>

    <button
      type="button"
      class="resume-tool"
      role="switch"
      aria-checked="false"
      data-theme-toggle
      aria-label="Switch to dark mode"
    >
      <svg class="resume-tool__sun" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path
          d="M12 4V2M12 22v-2M4 12H2M22 12h-2M5 5 3.5 3.5M20.5 20.5 19 19M19 5l1.5-1.5M3.5 20.5 5 19"
          stroke="currentColor"
          stroke-width="2.25"
          stroke-linecap="round"></path>
        <circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="2.25"></circle>
      </svg>
      <svg class="resume-tool__moon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path
          d="M20 14.2A7.4 7.4 0 0 1 9.8 4a8.6 8.6 0 1 0 10.2 10.2Z"
          stroke="currentColor"
          stroke-width="2.25"
          stroke-linejoin="round"></path>
      </svg>
    </button>
</div>

<script>
  const printButton = document.querySelector<HTMLButtonElement>("[data-resume-print]");
  printButton?.addEventListener("click", () => window.print());

  /* Highlights the section currently in view. IntersectionObserver rather than
     a scroll handler so the browser does the work off the main thread. */
  const links = [...document.querySelectorAll<HTMLAnchorElement>("[data-resume-nav]")];
  const targets = links
    .map((link) => document.getElementById(link.dataset.resumeNav ?? ""))
    .filter((el): el is HTMLElement => el !== null);

  if (targets.length > 0) {
    const setCurrent = (id: string) => {
      for (const link of links) {
        link.setAttribute("aria-current", link.dataset.resumeNav === id ? "true" : "false");
      }
    };

    setCurrent(targets[0].id);

    /* Clicking jumps to a heading that often lands outside the observer's
       narrow band, so the highlight would not move until the next scroll.
       Setting it here — and holding it until the smooth scroll settles —
       keeps the click and the highlight in step. */
    let lockedUntil = 0;

    for (const link of links) {
      link.addEventListener("click", () => {
        const id = link.dataset.resumeNav;
        if (!id) return;
        setCurrent(id);
        lockedUntil = Date.now() + 700;
      });
    }

    const observer = new IntersectionObserver(
      (entries) => {
        if (Date.now() < lockedUntil) return;

        // Several sections can straddle the band at once; the topmost wins.
        const visible = entries
          .filter((entry) => entry.isIntersecting)
          .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);

        if (visible[0]) setCurrent(visible[0].target.id);
      },
      { rootMargin: "-20% 0px -70% 0px" },
    );

    for (const target of targets) observer.observe(target);
  }
</script>

<style>
  /* Navigator tracks reading position, so it sits at eye level; the tools are
     actions taken once, so they stay out of the way at the bottom. */
  .resume-nav {
    position: fixed;
    right: 1.5rem;
    top: 50%;
    z-index: 10;
    transform: translateY(-50%);
  }

  .resume-nav ul {
    display: grid;
    gap: 0.35rem;
    margin: 0;
    padding: 0;
    list-style: none;
    text-align: right;
  }

  .resume-nav a {
    display: block;
    border-right: 2px solid transparent;
    padding: 0.15rem 0.6rem 0.15rem 0;
    color: var(--muted-foreground);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-decoration: none;
    text-transform: uppercase;
    transition:
      color var(--duration) var(--ease-out),
      border-color var(--duration) var(--ease-out);
  }

  .resume-nav a:hover,
  .resume-nav a:focus-visible {
    color: var(--foreground);
  }

  .resume-nav a[aria-current="true"] {
    border-right-color: var(--accent);
    color: var(--accent);
    font-weight: 600;
  }

  .resume-tools {
    position: fixed;
    right: 1.5rem;
    bottom: 1.5rem;
    z-index: 10;
    display: grid;
    gap: 0.5rem;
  }

  .resume-tool {
    display: grid;
    width: 2.25rem;
    height: 2.25rem;
    place-items: center;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--card);
    color: var(--muted-foreground);
    padding: 0;
    cursor: pointer;
    transition:
      border-color var(--duration) var(--ease-out),
      color var(--duration) var(--ease-out);
  }

  .resume-tool:hover,
  .resume-tool:focus-visible {
    border-color: color-mix(in srgb, var(--accent) 45%, var(--border));
    color: var(--accent);
  }

  .resume-tool svg {
    width: 1.05rem;
    height: 1.05rem;
  }

  /* One icon at a time, swapped by the root theme attribute the layout sets. */
  .resume-tool__moon,
  :root[data-theme="dark"] .resume-tool__sun {
    display: none;
  }

  :root[data-theme="dark"] .resume-tool__moon {
    display: block;
  }

  /* The rail needs room the narrow viewport does not have, and it would sit on
     top of the content. The tools are small enough to stay. */
  @media (max-width: 80rem) {
    .resume-nav {
      display: none;
    }

    .resume-tools {
      right: 1rem;
      bottom: 1rem;
    }
  }

  /* Controls are screen furniture: never put them on paper. */
  @media print {
    .resume-nav,
    .resume-tools {
      display: none;
    }
  }
</style>
